// دالة لجلب رابط صورة عشوائية للأذكار لمنع حدوث خطأ في البوت
export function getRandomAzkarImage(type = 'general') {
    const list = azkarMedia[type] || azkarMedia.general;
    const randomIndex = Math.floor(Math.random() * list.length);
    return list[randomIndex];
}
